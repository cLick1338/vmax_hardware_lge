//Vmax
// Loaded by audioserver in place of the default policy manager
cc_library_shared {
    name: "libaudiopolicymanagercustom",
    system_ext_specific: true,
    // audioserver is 64-bit only
    compile_multilib: "first",
    defaults: ["latest_android_media_audio_common_types_cpp_shared"],
    srcs: ["HiFiDacAudioPolicyManager.cpp"],
    shared_libs: [
        "audioclient-types-aidl-cpp",
        "audiopolicy-aidl-cpp",
        "framework-permission-aidl-cpp",
        "libaudiofoundation",
        "libaudiopolicycomponents",
        "libaudiopolicymanagerdefault",
        "libbinder",
        "libcutils",
        "liblog",
        "libmedia_helper",
        "libutils",
    ],
    header_libs: [
        "libaudiopolicycommon",
        "libaudiopolicyengine_interface_headers",
        "libaudiopolicymanager_interface_headers",
    ],
    cflags: [
        "-Wall",
        "-Werror",
    ],
}
